PORT=3000

DB_HOST=db
DB_PORT=5432
DB_NAME=cutdb
DB_USER=user
DB_PASSWORD=1234

# 테스트 전용: true면 진행 중인 운행 및 in_use 킥보드로도 새 운행 시작 허용
ALLOW_CONCURRENT_RIDES=false

JWT_SECRET=safe-kick-dev-secret

# Raspberry Pi 내부 API 인증키 (Node와 Pi에 동일하게 설정)
INTERNAL_API_KEY=replace-with-a-long-random-value

# 32바이트 키의 Base64 값: openssl rand -base64 32
FACE_EMBEDDING_ENCRYPTION_KEY=replace-with-32-byte-base64-key
